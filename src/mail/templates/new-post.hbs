<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{t 'emails.post_published_title'}}</title>
</head>
<body style="margin:0;padding:0;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">

  <!-- Preheader -->
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;">
    {{postExcerpt}}
  </div>

  <!-- Preheader -->
  {{!-- <div>
    {{t 'emails.welcome.subject' author='ozal' email='email@email.com' }}
  </div> --}}

  <table role="presentation" width="100%" cellspacing="0" cellpadding="0"
    border="0" style="background:#f4f6f8;">
    <tr>
      <td align="center" style="padding:32px 16px;">

        <table role="presentation" width="600" cellspacing="0"
          cellpadding="0" border="0"
          style="width:100%;max-width:600px;background:#ffffff;border-radius:12px;">

          <!-- Header -->
          <tr>
            <td style="padding:24px 32px;border-bottom:1px solid #e5e7eb;">
              <a href="{{appUrl}}"
                style="font-size:22px;font-weight:bold;color:#2563eb;text-decoration:none;">
                {{appName}}
              </a>
            </td>
          </tr>

          <!-- Main content -->
          <tr>
            <td style="padding:32px;">

              {{!-- <h1 style="margin:0 0 16px;font-size:26px;line-height:1.3;color:#111827;">
                A new post is here!
              </h1> --}}

              <p style="margin:0 0 20px;font-size:16px;line-height:1.7;color:#4b5563;">
                {{t 'emails.common_greeting'}},
                <br><br>
                {{t 'emails.post_published_description'}}.
              </p>

              <!-- Post card -->
              <table role="presentation" width="100%" cellspacing="0"
                cellpadding="0" border="0"
                style="border:1px solid #e5e7eb;border-radius:8px;">
                <tr>
                  <td style="padding:24px;">

                    <p style="margin:0 0 10px;font-size:12px;font-weight:bold;
                      letter-spacing:1px;color:#2563eb;">
                      {{t 'emails.post_published_badge'}}
                    </p>

                    <h2 style="margin:0 0 12px;font-size:22px;line-height:1.4;color:#111827;">
                      {{postTitle}}
                    </h2>

                    <p style="width: 552px; overflow: hidden">
                      <img src="{{postCoverImageUrl}}" alt="" style="max-width: 100%">
                    </p>

                    <p style="margin:0 0 16px;font-size:14px;color:#6b7280;">
                      {{t 'emails.common_by'}} {{authorFullName}} {{!-- · {{reading_time}} min read --}}
                    </p>

                    <p style="margin:0 0 24px;font-size:15px;line-height:1.7;color:#4b5563;">
                      {{postExcerpt}}
                    </p>

                    <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                      <tr>
                        <td align="center" bgcolor="#2563eb"
                          style="border-radius:6px;">
                          <a href="{{postUrl}}"
                            style="display:inline-block;padding:14px 24px;
                            font-size:15px;font-weight:bold;color:#ffffff;
                            text-decoration:none;border-radius:6px;">
                            {{t 'emails.post_readFull'}} →
                          </a>
                        </td>
                      </tr>
                    </table>

                    <p style="margin:24px 0 0;font-size:12px;line-height:1.6;color:#6b7280;">
                      {{t 'emails.email_copyLinkHint'}}:
                      <br>
                      <a href="{{postUrl}}" style="color:#2563eb;word-break:break-all;">
                        {{postUrl}}
                      </a>
                    </p>

                  </td>
                </tr>
              </table>

              <p style="margin:28px 0 0;font-size:15px;line-height:1.7;color:#4b5563;">
                {{t 'emails.email_communityThanks'}}!
                <br><br>
                {{t 'emails.common_regards'}},<br>
                <strong>{{appName}} {{t 'emails.common_team'}}</strong>
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:24px 32px;background:#f9fafb;border-top:1px solid #e5e7eb;">
              <p style="margin:0 0 8px;text-align:center;font-size:12px;line-height:1.6;color:#6b7280;">
                {{t 'emails.email_whyReceiveAnswer'}}.
              </p>
              <p style="margin:0;text-align:center;font-size:12px;color:#6b7280;">
                <a href="{{unsubscribeUrl}}" style="color:#6b7280;">{{t 'emails.email_unsubscribe'}}</a>
                &nbsp;·&nbsp;
                {{!-- <a href="{{privacy_url}}" style="color:#6b7280;">Privacy Policy</a> --}}
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>